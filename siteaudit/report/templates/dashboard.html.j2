<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Relatório — {{ meta.niche }} em {{ meta.place }}</title>
<style>
  :root{--ink:#0f172a;--muted:#5b6478;--line:rgba(15,23,42,.09);--bg:#f7f9fc;--accent:#2563eb;
        --critico:#dc2626;--alto:#ea580c;--medio:#ca8a04;--baixo:#0d9488;--ok:#16a34a}
  *{box-sizing:border-box}
  body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif;
       background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased}
  .wrap{max-width:1280px;margin:0 auto;padding:0 24px}
  header{background:linear-gradient(135deg,#0f172a,#1e3a8a);color:#fff;padding:38px 0 30px}
  h1{margin:0 0 8px;font-size:clamp(24px,3.4vw,34px);letter-spacing:-.025em}
  .meta{opacity:.8;font-size:14px}
  .kpis{display:grid;gap:14px;margin-top:26px;grid-template-columns:repeat(auto-fit,minmax(168px,1fr))}
  .kpi{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.16);border-radius:14px;padding:16px}
  .kpi b{display:block;font-size:26px;letter-spacing:-.02em}
  .kpi span{font-size:12.5px;opacity:.82}
  .toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:26px 0 14px}
  input[type=search]{flex:1;min-width:220px;padding:11px 14px;border-radius:10px;border:1px solid var(--line);
                     font-size:14.5px;background:#fff;font-family:inherit}
  .chip{border:1px solid var(--line);background:#fff;border-radius:999px;padding:8px 14px;font-size:13.5px;
        cursor:pointer;font-weight:600;color:var(--muted)}
  .chip.active{background:var(--ink);color:#fff;border-color:var(--ink)}
  .tablewrap{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:auto;box-shadow:0 6px 20px rgba(15,23,42,.05)}
  table{width:100%;border-collapse:collapse;font-size:14px}
  th{text-align:left;padding:12px 14px;background:#f1f5f9;font-size:12.5px;text-transform:uppercase;
     letter-spacing:.04em;color:var(--muted);cursor:pointer;white-space:nowrap;position:sticky;top:0}
  td{padding:12px 14px;border-top:1px solid var(--line);vertical-align:middle}
  tr:hover td{background:#fafcff}
  .score{display:inline-grid;place-items:center;width:38px;height:38px;border-radius:10px;font-weight:800;color:#fff;font-size:14px}
  .badge{display:inline-block;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700;white-space:nowrap}
  .badge.critico{background:#fee2e2;color:#991b1b}
  .badge.alto{background:#ffedd5;color:#9a3412}
  .badge.medio{background:#fef9c3;color:#854d0e}
  .badge.ok{background:#dcfce7;color:#166534}
  .badge.neutro{background:#e2e8f0;color:#334155}
  a{color:var(--accent);text-decoration:none;font-weight:600}
  a:hover{text-decoration:underline}
  .actions{display:flex;gap:8px;white-space:nowrap}
  .mini{font-size:12.5px;padding:6px 10px;border-radius:8px;border:1px solid var(--line);background:#fff}
  .name{font-weight:700}
  .small{font-size:12.5px;color:var(--muted)}
  section{padding:26px 0 60px}
  h2{font-size:20px;margin:34px 0 12px;letter-spacing:-.02em}
  .grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
  .card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px;box-shadow:0 6px 20px rgba(15,23,42,.05)}
  .card h3{margin:0 0 8px;font-size:15.5px}
  .card p{margin:0;color:var(--muted);font-size:13.5px}
  footer{padding:30px 0 50px;color:var(--muted);font-size:13px;text-align:center}
  .empty{padding:40px;text-align:center;color:var(--muted)}
  .err{background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;border-radius:12px;padding:14px 16px;font-size:13.5px;margin-top:16px}
</style>
</head>
<body>
<header>
  <div class="wrap">
    <h1>{{ meta.niche }} — {{ meta.place }}</h1>
    <div class="meta">Relatório gerado em {{ meta.generated_at }} · {{ meta.leads_total }} empresas encontradas · provedores: {{ meta.providers }}</div>
    <div class="kpis">
      <div class="kpi"><b>{{ meta.leads_total }}</b><span>empresas no mapa</span></div>
      <div class="kpi"><b>{{ meta.with_site }}</b><span>com site próprio</span></div>
      <div class="kpi"><b>{{ meta.no_site }}</b><span>site próprio não localizado</span></div>
      <div class="kpi"><b>{{ meta.avg_score }}</b><span>nota média dos sites</span></div>
      <div class="kpi"><b>{{ meta.hot_leads }}</b><span>oportunidade alta+</span></div>
    </div>
  </div>
</header>

<div class="wrap">
  <section>
    {% if meta.errors %}
    <div class="err"><b>Avisos da descoberta:</b><br>{{ meta.errors | join('<br>') | safe }}</div>
    {% endif %}

    <div class="toolbar">
      <input type="search" id="q" placeholder="Buscar empresa, cidade ou domínio...">
      <button class="chip active" data-filter="all">Todos</button>
      <button class="chip" data-filter="nosite">Site não localizado</button>
      <button class="chip" data-filter="hot">Oportunidade alta+</button>
      <button class="chip" data-filter="worst">Piores notas</button>
      <button class="chip" data-filter="mobile">Problemas no mobile</button>
      <button class="chip" data-filter="nowhats">Sem WhatsApp</button>
    </div>

    <div class="tablewrap">
      <table id="tbl">
        <thead><tr>
          <th data-sort="name">Empresa</th>
          <th data-sort="city">Cidade/UF</th>
          <th data-sort="site">Site</th>
          <th data-sort="phone">Contato</th>
          <th data-sort="score">Nota</th>
          <th data-sort="opportunity">Oportunidade</th>
          <th>Achados</th>
          <th>Ações</th>
        </tr></thead>
        <tbody>
        {% for r in rows %}
        <tr data-name="{{ r.name|lower }}" data-city="{{ r.city|lower }}" data-site="{{ r.site|lower }}"
            data-nosite="{{ 1 if not r.has_site else 0 }}" data-score="{{ r.score if r.score is not none else -1 }}"
            data-hot="{{ 1 if r.hot else 0 }}" data-mobile="{{ 1 if r.mobile_issue else 0 }}"
            data-nowhats="{{ 1 if r.nowhats else 0 }}">
          <td class="name">{{ r.name }}<div class="small">{{ r.category }}</div></td>
          <td>{{ r.city }}<div class="small">{{ r.address }}</div></td>
          <td>{% if r.site %}<a href="{{ r.site }}" target="_blank" rel="noopener">{{ r.site_short }}</a>{% else %}<span class="badge neutro">site não localizado</span>{% endif %}</td>
          <td>{{ r.phone or '—' }}<div class="small">{{ r.email or '' }}</div></td>
          <td>{% if r.score is not none %}<span class="score" style="background:{{ r.score_color }}">{{ r.score }}</span>{% else %}<span class="badge neutro">n/a</span>{% endif %}</td>
          <td><span class="badge {{ r.opp_class }}">{{ r.opportunity }}</span></td>
          <td>{% if r.counts %}<span class="badge critico">{{ r.counts.critico }} crítico</span> <span class="badge alto">{{ r.counts.alto }} alto</span>{% else %}<span class="small">—</span>{% endif %}</td>
          <td class="actions">
            {% if r.report %}<a class="mini" href="{{ r.report }}">Relatório</a>{% endif %}
            <a class="mini" href="{{ r.demo }}">Demo</a>
            {% if r.maps_url %}<a class="mini" href="{{ r.maps_url }}" target="_blank" rel="noopener">Maps</a>{% endif %}
          </td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
      <div class="empty" id="empty" style="display:none">Nenhum lead corresponde ao filtro.</div>
    </div>

    <h2>Como usar este relatório</h2>
    <div class="grid">
      <div class="card"><h3>1. Revise quem não teve site localizado</h3><p>É um sinal de possível oportunidade, não prova de que a empresa não possui site. Confirme a informação antes de abordar.</p></div>
      <div class="card"><h3>2. Use a nota como argumento</h3><p>Abra o relatório do lead, mostre os achados críticos e em seguida a <b>demo</b> que já está pronta na pasta <code>propostas/</code>. O contraste “antes e depois” vende.</p></div>
      <div class="card"><h3>3. Leve o diagnóstico impresso</h3><p>Cada relatório traz SEO, performance, design e conversão com o que precisa ser corrigido — parece consultoria, custa pouco para você produzir.</p></div>
      <div class="card"><h3>4. Dados brutos</h3><p><code>leads.csv</code> para planilha/CRM e <code>sites/&lt;domínio&gt;.json</code> com tudo que foi extraído, pronto para alimentar outra IA ou gerador de sites.</p></div>
    </div>

    <h2>Palavras-chave mais comuns no nicho</h2>
    <div class="card"><p>{% for kw in meta.top_keywords %}<span class="badge neutro" style="margin:3px 4px 3px 0">{{ kw.0 }} ({{ kw.1 }})</span>{% endfor %}</p></div>
  </section>
  <footer>siteaudit v{{ meta.version }} · dados coletados de fontes públicas. Respeite os termos de uso de cada provedor.</footer>
</div>

<script>
const q = document.getElementById('q');
const chips = document.querySelectorAll('.chip');
const rows = Array.from(document.querySelectorAll('#tbl tbody tr'));
let filter = 'all', sortKey = 'score', sortAsc = true;

function apply(){
  const term = (q.value || '').toLowerCase();
  let visible = 0;
  rows.forEach(r => {
    let ok = true;
    if (filter === 'nosite') ok = r.dataset.nosite === '1';
    else if (filter === 'hot') ok = r.dataset.hot === '1';
    else if (filter === 'worst') ok = r.dataset.score !== '-1' && Number(r.dataset.score) < 60;
    else if (filter === 'mobile') ok = r.dataset.mobile === '1';
    else if (filter === 'nowhats') ok = r.dataset.nowhats === '1';
    if (ok && term) ok = (r.dataset.name + ' ' + r.dataset.city + ' ' + r.dataset.site).includes(term);
    r.style.display = ok ? '' : 'none';
    if (ok) visible++;
  });
  document.getElementById('empty').style.display = visible ? 'none' : '';
}
function sortBy(key){
  const tbody = document.querySelector('#tbl tbody');
  const arr = rows.slice();
  arr.sort((a,b) => {
    let va = a.dataset[key] ?? a.children[0].innerText;
    let vb = b.dataset[key] ?? b.children[0].innerText;
    if (key === 'name' || key === 'city' || key === 'site') { va = a.dataset[key]; vb = b.dataset[key]; }
    if (key === 'score') { va = Number(a.dataset.score); vb = Number(b.dataset.score); }
    if (va < vb) return sortAsc ? -1 : 1;
    if (va > vb) return sortAsc ? 1 : -1;
    return 0;
  });
  arr.forEach(r => tbody.appendChild(r));
}
q.addEventListener('input', apply);
chips.forEach(c => c.addEventListener('click', () => {
  chips.forEach(x => x.classList.remove('active'));
  c.classList.add('active'); filter = c.dataset.filter; apply();
}));
document.querySelectorAll('th[data-sort]').forEach(th => th.addEventListener('click', () => {
  const key = th.dataset.sort;
  sortAsc = (key === sortKey) ? !sortAsc : true;
  sortKey = key; sortBy(key);
}));
sortBy('score'); apply();
</script>
</body>
</html>
